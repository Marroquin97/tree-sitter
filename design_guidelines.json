    "icons": {
      "library": "lucide-react",
      "preferred": ["Cpu", "FlaskConical", "GraduationCap", "Menu", "X", "ArrowRight", "ChevronDown", "Hexagon"]
    }
  },
  "tech_requirements": {
    "required_packages": [
      "framer-motion",
      "lenis",
      "clsx",
      "tailwind-merge",
      "lucide-react"
    ],
    "setup_instructions": "Install framer-motion and @studio-freight/lenis immediately. Configure Tailwind to use the custom colors and fonts."
  },
  "universal_guidelines": [
    "Do not use gradients for main backgrounds, use solid dark colors with noise texture.",
    "Use 'Syne' font for all headings. Import from Google Fonts.",
    "Use 'Outfit' font for all body text.",
    "Ensure all interactive elements have a hover state (text color change or scale).",
    "Use the 'Gold' accent sparingly - only for key borders, active states, or primary buttons.",
    "Implement smooth scrolling using Lenis.",
    "Mobile First: Stack columns vertically on mobile, triptych on desktop."
  ]
}