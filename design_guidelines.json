{
  "brand_identity": {
    "name": "ATARAXIA TECH LAB",
    "tagline": "Engineering Experiences",
    "mission": "Unifying technical precision with human sensory experience.",
    "emotional_tone": "Industrial Luxury, Precision, Alchemical, Executive",
    "archetype": "The Alchemist (Tech + Magic)",
    "keywords": ["Precision", "Gold", "Dark", "Systems", "Sensory"]
  },
  "design_system": {
    "theme": "dark",
    "colors": {
      "background": {
        "primary": "#050505",
        "secondary": "#0A0A0A",
        "tertiary": "#121212"
      },
      "text": {
        "primary": "#EDEDED",
        "secondary": "#A1A1AA",
        "muted": "#52525B"
      },
      "accent": {
        "gold": "#D4AF37",
        "gold_dim": "#8F7218",
        "gold_light": "#FCD34D",
        "blue_tech": "#3B82F6",
        "red_alert": "#EF4444"
      },
      "border": {
        "subtle": "rgba(255, 255, 255, 0.08)",
        "gold": "rgba(212, 175, 55, 0.3)"
      }
    },
    "typography": {
      "headings": {
        "family": "Syne, sans-serif",
        "weights": ["700", "800"],
        "usage": "Hero titles, Section headers. Use 'Syne' from Google Fonts."
      },
      "body": {
        "family": "Outfit, sans-serif",
        "weights": ["300", "400", "500"],
        "usage": "Paragraphs, UI elements, Labels. Use 'Outfit' from Google Fonts."
      },
      "mono": {
        "family": "JetBrains Mono, monospace",
        "usage": "Code snippets, Technical specs, Coordinates"
      }
    },
    "spacing": {
      "container_padding": "p-6 md:p-12 lg:p-24",
      "section_gap": "gap-24 md:gap-32",
      "element_gap": "gap-6"
    },
    "effects": {
      "glass": "backdrop-blur-xl bg-black/40 border border-white/5",
      "gold_glow": "shadow-[0_0_30px_rgba(212,175,55,0.15)]",
      "tech_glow": "shadow-[0_0_20px_rgba(59,130,246,0.2)]"
    }
  },
  "layout_strategies": {
    "hero": {
      "type": "asymmetric_split",
      "description": "Left: Massive Typography (Syne ExtraBold). Right: Abstract 3D/Video element. Bottom: Scrolling marquee of services."
    },
    "divisions_section": {
      "type": "the_triptych",
      "description": "Three vertical columns (Systems, Experience, Academy). Default: Equal width. Hover: Expands to 60% width while others shrink. Each column has a distinct background image with overlay."
    },
    "bento_grid": {
      "type": "mode_a_tetris",
      "description": "Use for Portfolio/Case Studies. Mix of 1x1, 2x1, and 2x2 cells. High gap (gap-6)."
    }
  },
